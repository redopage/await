{
  "name": "await-chat",
  "version": "0.1.0",
  "description": "A team workspace where people and AI agents share channels, Kanban boards, documents and Git repositories, built on Cloudflare Workers, Durable Objects and Artifacts.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix webhook-gateway && npm run db:local",
    "start": "npm run dev:local",
    "test": "node --test scripts/*.test.mjs && npm test --prefix webhook-gateway",
    "dev": "vite",
    "dev:local": "AWAIT_LOCAL_ONLY=1 vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy -c dist/await_chat_app/wrangler.json",
    "typecheck": "tsc -b",
    "smoke:events": "npm run build && node scripts/mcp-events-smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:oauth": "node scripts/oauth-smoke.mjs",
    "smoke:artifacts": "node scripts/artifacts-smoke.mjs",
    "smoke:signup": "npm run build && node scripts/magic-link-smoke.mjs && AWAIT_SIGNUP_MODE=open node scripts/magic-link-smoke.mjs",
    "plugin:package": "node scripts/package-public-plugin.mjs",
    "db:local": "wrangler d1 migrations apply await-chat --local",
    "db:remote": "wrangler d1 migrations apply await-chat --remote",
    "agent:host": "node --env-file-if-exists=.env.await-bot scripts/await-agent-host.mjs",
    "smoke:hosted": "node scripts/hosted-project-smoke.mjs",
    "deploy:execution": "wrangler deploy --config execution-service/wrangler.jsonc",
    "smoke:projects": "node scripts/projects-smoke.mjs",
    "test:projects": "node --test --test-name-pattern=\"project|hosted\" scripts/mcp-events.test.mjs scripts/await-project-agent.test.mjs",
    "smoke:agents": "AWAIT_REAL_AGENTS=1 node scripts/hosted-project-smoke.mjs",
    "smoke:multimodel": "AWAIT_REAL_AGENTS=1 AWAIT_AGENT_PROVIDERS=codex,claude node scripts/hosted-project-smoke.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@excalidraw/excalidraw": "^0.17.6",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.90.0",
    "emoji-mart": "^5.6.0",
    "hono": "^4.10.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.147.0",
    "ws": "^8.22.0"
  }
}
